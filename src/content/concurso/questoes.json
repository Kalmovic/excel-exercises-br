      "linhas": 6,
      "colunas": 6,
      "celulas": {}
    },
    "dicas": [],
    "explicacao": [
      "Primeiro a potência (2^2 = 4), depois a multiplicação (3*4 = 12) e por fim a soma (2+12 = 14)."
    ],
    "tentativasAteExplicacao": 1,
    "type": "multiple_choice",
    "opcoes": [
      {
        "texto": "14"
      },
      {
        "texto": "20",
        "dica": "Confira a ordem: a soma não é feita antes da multiplicação."
      },
      {
        "texto": "38",
        "dica": "A potência vale só para o número imediatamente antes do ^."
      },
      {
        "texto": "64",
        "dica": "Os parênteses que mudariam a ordem não estão na fórmula."
      },
      {
        "texto": "100",
        "dica": "Releia a ordem de precedência: potência, depois multiplicação, depois soma."
      }
    ],
    "correta": 0,
    "banca": "FCC",
    "tema": "Operadores",
    "referencia": {
      "prova": "FCC · TRT 21ª Região · Analista Judiciário · 2003",
      "url": "https://www.tecconcursos.com.br/questoes/578608"
    },
    "comPlanilha": true,
    "conferir": [
      {
        "formula": "=2+3*2^2",
        "esperado": 14
      }
    ]
  },
