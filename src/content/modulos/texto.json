        "celula": "B3",
        "esperado": "2025",
        "exigeFormula": true,
        "solucaoReferencia": "=EXT.TEXTO(A3;5;4)"
      },
      {
        "celula": "B4",
        "esperado": "2026",
        "exigeFormula": true,
        "solucaoReferencia": "=EXT.TEXTO(A4;5;4)"
      },
      {
        "celula": "B5",
        "esperado": "2025",
        "exigeFormula": true,
        "solucaoReferencia": "=EXT.TEXTO(A5;5;4)"
      },
      {
        "celula": "B6",
        "esperado": "2026",
        "exigeFormula": true,
        "solucaoReferencia": "=EXT.TEXTO(A6;5;4)"
      }
    ],
    "dicas": [
