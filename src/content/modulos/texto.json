[
  {
    "id": "8c729b41-1595-5485-931d-77faaeb56919",
    "slug": "juntar-nome-e-sobrenome-com-espaco",
    "type": "formula",
    "trilha": "excel-ptbr",
    "modulo": "texto",
    "ordem": 1,
    "nivel": 1,
    "plano": "free",
    "versao": 1,
    "titulo": "Juntar textos: & e CONCAT",
    "intro": "Nome numa coluna, sobrenome em outra, e você precisa do nome completo.",
    "enunciado": [
      "Em **C2**, monte o nome completo (ex.: \"Maria Souza\") e copie até **C4**."
    ],
    "grade": {
      "linhas": 5,
      "colunas": 4,
      "celulas": {
        "A1": {
          "entrada": "Nome",
          "negrito": true
        },
        "B1": {
          "entrada": "Sobrenome",
          "negrito": true
        },
        "C1": {
          "entrada": "Nome completo",
          "negrito": true
        },
        "A2": {
          "entrada": "Maria"
        },
        "B2": {
          "entrada": "Souza"
        },
        "A3": {
          "entrada": "João"
        },
        "B3": {
          "entrada": "Lima"
        },
        "A4": {
          "entrada": "Ana"
        },
        "B4": {
          "entrada": "Dias"
        }
      },
      "larguras": {
        "C": 150
      }
    },
    "alvos": [
      {
        "celula": "C2",
        "esperado": "Maria Souza",
        "exigeFormula": true,
        "solucaoReferencia": "=A2&\" \"&B2"
      },
      {
        "celula": "C3",
        "esperado": "João Lima",
        "exigeFormula": true,
        "solucaoReferencia": "=A3&\" \"&B3"
      },
      {
        "celula": "C4",
        "esperado": "Ana Dias",
        "exigeFormula": true,
        "solucaoReferencia": "=A4&\" \"&B4"
      }
    ],
    "dicas": [
      "O `&` cola textos.",
      "O espaço também é um texto: `\" \"`."
    ],
    "explicacao": [
      "`=A2&\" \"&B2`. Sem o espaço entre aspas, sairia \"MariaSouza\".",
      "Com função: `=CONCAT(A2;\" \";B2)`."
    ],
    "tentativasAteExplicacao": 3,
    "errosComuns": [
      {
        "padrao": "^=A\\d&B\\d$",
        "dica": "Faltou o espaço entre o nome e o sobrenome: =A2&\" \"&B2."
      },
      {
        "padrao": "^=A\\d\\+B\\d$",
        "dica": "O + soma números. Para juntar textos, use &."
      }
    ],
    "video": "Juntar três colunas (rua, número, bairro) num endereço completo."
  },
  {
