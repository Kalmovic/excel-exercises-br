  {
    "id": "e0233cf7-0da4-5e71-aee2-a2f0e3d522b1",
    "slug": "localizar-primeiro-nome",
    "type": "formula",
    "trilha": "excel-ptbr",
    "modulo": "texto",
    "ordem": 7,
    "nivel": 3,
    "plano": "pro",
    "versao": 1,
    "titulo": "LOCALIZAR + ESQUERDA: o primeiro nome",
    "enunciado": [
      "Os nomes têm tamanhos diferentes, então não dá para pegar um número fixo de letras.",
      "Em **B2:B5**, extraia o primeiro nome: tudo antes do primeiro espaço."
    ],
    "grade": {
      "linhas": 6,
      "colunas": 3,
      "celulas": {
        "A1": {
          "entrada": "Nome completo",
          "negrito": true
        },
        "B1": {
          "entrada": "Primeiro nome",
          "negrito": true
        },
        "A2": {
          "entrada": "Mariana Alves"
        },
        "A3": {
          "entrada": "João Pedro Santos"
        },
        "A4": {
          "entrada": "Lu Prado"
        },
        "A5": {
          "entrada": "Roberto Nunes"
        }
      },
      "larguras": {
        "A": 170,
        "B": 130
      }
    },
    "alvos": [
      {
        "celula": "B2",
        "esperado": "Mariana",
        "exigeFormula": true,
        "solucaoReferencia": "=ESQUERDA(A2;LOCALIZAR(\" \";A2)-1)"
      },
      {
        "celula": "B3",
        "esperado": "João",
        "exigeFormula": true,
        "solucaoReferencia": "=ESQUERDA(A3;LOCALIZAR(\" \";A3)-1)"
      },
      {
        "celula": "B4",
        "esperado": "Lu",
        "exigeFormula": true,
        "solucaoReferencia": "=ESQUERDA(A4;LOCALIZAR(\" \";A4)-1)"
      },
      {
        "celula": "B5",
        "esperado": "Roberto",
        "exigeFormula": true,
        "solucaoReferencia": "=ESQUERDA(A5;LOCALIZAR(\" \";A5)-1)"
      }
    ],
    "dicas": [
      "`LOCALIZAR(\" \";A2)` diz em que posição está o primeiro espaço.",
      "O primeiro nome tem uma letra a menos que essa posição: `ESQUERDA(A2;posição-1)`."
    ],
    "explicacao": [
      "`=ESQUERDA(A2;LOCALIZAR(\" \";A2)-1)`: em \"Lu Prado\" o espaço está na posição 3, então pega 2 letras.",
      "É a combinação mais usada para separar textos de tamanho variável."
    ],
    "tentativasAteExplicacao": 3,
    "funcoesExigidas": [
      "LEFT",
      "SEARCH"
    ]
  }
]
