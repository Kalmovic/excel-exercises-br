        "exigeFormula": true,
        "solucaoReferencia": "=ESQUERDA(A4;2)"
      },
      {
        "celula": "C2",
        "esperado": "0042",
        "exigeFormula": true,
        "solucaoReferencia": "=DIREITA(A2;4)"
      },
      {
        "celula": "C3",
        "esperado": "0107",
        "exigeFormula": true,
        "solucaoReferencia": "=DIREITA(A3;4)"
      },
      {
        "celula": "C4",
        "esperado": "1530",
        "exigeFormula": true,
        "solucaoReferencia": "=DIREITA(A4;4)"
      }
    ],
    "dicas": [
