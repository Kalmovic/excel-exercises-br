  {
    "id": "2a1c86a3-eb69-5e1c-b0b7-e61c32b9b7b0",
    "slug": "num-caract-validar-tamanho",
    "type": "formula",
    "trilha": "excel-ptbr",
    "modulo": "texto",
    "ordem": 5,
    "nivel": 2,
    "plano": "pro",
    "versao": 1,
    "titulo": "NÚM.CARACT: o CPF tem 11 dígitos?",
    "enunciado": [
      "Em **B2:B7**, escreva \"OK\" quando o CPF tiver exatamente **11** caracteres e \"Verificar\" quando não tiver."
    ],
    "grade": {
      "linhas": 8,
      "colunas": 3,
      "celulas": {
        "A1": {
          "entrada": "CPF (só números)",
          "negrito": true
        },
        "B1": {
          "entrada": "Válido?",
          "negrito": true
        },
        "A2": {
          "entrada": "12345678901"
        },
        "A3": {
          "entrada": "9876543210"
        },
        "A4": {
          "entrada": "11122233344"
        },
        "A5": {
          "entrada": "555666777"
        },
        "A6": {
          "entrada": "40011122233"
        },
        "A7": {
          "entrada": "123456789012"
        }
      },
      "larguras": {
        "A": 160
      }
    },
    "alvos": [
      {
        "celula": "B2",
        "esperado": "OK",
        "exigeFormula": true,
        "solucaoReferencia": "=SE(NÚM.CARACT(A2)=11;\"OK\";\"Verificar\")"
      },
      {
        "celula": "B3",
        "esperado": "Verificar",
        "exigeFormula": true,
        "solucaoReferencia": "=SE(NÚM.CARACT(A3)=11;\"OK\";\"Verificar\")"
      },
      {
        "celula": "B4",
        "esperado": "OK",
        "exigeFormula": true,
        "solucaoReferencia": "=SE(NÚM.CARACT(A4)=11;\"OK\";\"Verificar\")"
      },
      {
        "celula": "B5",
        "esperado": "Verificar",
        "exigeFormula": true,
        "solucaoReferencia": "=SE(NÚM.CARACT(A5)=11;\"OK\";\"Verificar\")"
      },
      {
        "celula": "B6",
        "esperado": "OK",
        "exigeFormula": true,
        "solucaoReferencia": "=SE(NÚM.CARACT(A6)=11;\"OK\";\"Verificar\")"
      },
      {
        "celula": "B7",
        "esperado": "Verificar",
        "exigeFormula": true,
        "solucaoReferencia": "=SE(NÚM.CARACT(A7)=11;\"OK\";\"Verificar\")"
      }
    ],
    "dicas": [
      "`NÚM.CARACT(A2)` conta os caracteres.",
      "Use dentro de um SE: `=SE(NÚM.CARACT(A2)=11;…;…)`."
    ],
    "explicacao": [
      "`=SE(NÚM.CARACT(A2)=11;\"OK\";\"Verificar\")`.",
      "É uma checagem de tamanho, não de CPF válido: os dígitos verificadores precisam de outra conta."
    ],
    "tentativasAteExplicacao": 3,
    "funcoesExigidas": [
      "LEN",
      "IF"
    ]
  },
