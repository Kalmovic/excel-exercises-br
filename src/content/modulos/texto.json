    "plano": "pro",
    "versao": 1,
    "titulo": "Limpar nomes: ARRUMAR e PRI.MAIÚSCULA",
    "enunciado": [
      "Os nomes vieram de um formulário com espaços sobrando e maiúsculas bagunçadas.",
      "Em **B2:B6**, deixe cada nome sem espaços extras e com a inicial de cada palavra maiúscula."
    ],
    "grade": {
      "linhas": 7,
      "colunas": 3,
      "celulas": {
        "A1": {
          "entrada": "Como foi digitado",
          "negrito": true
        },
        "B1": {
          "entrada": "Corrigido",
          "negrito": true
        },
        "A2": {
          "entrada": "  ana   souza"
        },
        "A3": {
          "entrada": "BRUNO LIMA "
        },
        "A4": {
          "entrada": "carla  dias"
        },
        "A5": {
          "entrada": " DIEGO reis"
        },
        "A6": {
          "entrada": "elisa MELO"
        }
      },
      "larguras": {
        "A": 160,
        "B": 140
      }
    },
    "alvos": [
      {
        "celula": "B2",
        "esperado": "Ana Souza",
        "exigeFormula": true,
        "solucaoReferencia": "=PRI.MAIÚSCULA(ARRUMAR(A2))"
      },
      {
        "celula": "B3",
        "esperado": "Bruno Lima",
        "exigeFormula": true,
        "solucaoReferencia": "=PRI.MAIÚSCULA(ARRUMAR(A3))"
      },
      {
        "celula": "B4",
        "esperado": "Carla Dias",
        "exigeFormula": true,
        "solucaoReferencia": "=PRI.MAIÚSCULA(ARRUMAR(A4))"
      },
      {
        "celula": "B5",
        "esperado": "Diego Reis",
        "exigeFormula": true,
        "solucaoReferencia": "=PRI.MAIÚSCULA(ARRUMAR(A5))"
      },
      {
        "celula": "B6",
        "esperado": "Elisa Melo",
        "exigeFormula": true,
        "solucaoReferencia": "=PRI.MAIÚSCULA(ARRUMAR(A6))"
      }
    ],
    "dicas": [
      "ARRUMAR tira os espaços do começo, do fim e os repetidos no meio.",
      "PRI.MAIÚSCULA põe a primeira letra de cada palavra em maiúscula. Uma função vai dentro da outra."
    ],
    "explicacao": [
