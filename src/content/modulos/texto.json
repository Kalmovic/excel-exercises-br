      },
      {
        "padrao": "^=ESQUERDA\\(A\\d;4\\)$",
        "dica": "ESQUERDA pega do começo; DIREITA, do fim."
      }
    ],
    "video": "Por que o resultado é texto, e como transformar em número quando precisar.",
    "funcoesExigidas": [
