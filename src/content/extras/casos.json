        "solucaoReferencia": "=-PGTO(B2;B3;B1)",
        "formato": "moeda",
        "tolerancia": 0.005
      },
      {
        "celula": "B6",
        "esperado": 15054.930521969409,
        "exigeFormula": true,
        "solucaoReferencia": "=B5*B3",
        "formato": "moeda",
        "tolerancia": 0.05
      },
      {
        "celula": "B7",
        "esperado": 3054.930521969409,
        "exigeFormula": true,
        "solucaoReferencia": "=B6-B1",
        "formato": "moeda",
        "tolerancia": 0.05
      }
    ],
    "dicas": [
      "`=PGTO(taxa;número_de_parcelas;valor)`.",
      "O PGTO devolve negativo (é dinheiro saindo). Ponha um `-` na frente da função.",
      "Total pago = parcela × número de parcelas."
    ],
    "explicacao": [
